---
import { ClientRouter } from 'astro:transitions';
import "../styles/global.css";
// CSSのimportパスはご自身の環境に合わせてください(src/styles/site.css等)
import "../styles/site.css";

import Analytics from '@vercel/analytics/astro'

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: "/", label: "TOP" },
  { href: "/about/", label: "ABOUT" },
  { href: "/join/", label: "JOIN" },
  { href: "/report/", label: "REPORT" },
  { href: "/contact/", label: "CONTACT" },
];

const isActive = (href) => {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
};
---

<html lang="ja">
  <head>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <ClientRouter />
  </head>

  <body class="bg-sky-50 text-slate-800 font-sans min-h-screen flex flex-col">
    
    <header class="w-full bg-white/90 backdrop-blur-md sticky top-0 z-50 border-b border-sky-100">
      <div class="max-w-5xl mx-auto px-6 h-20 flex items-center justify-between">
        <a href="/" class="text-2xl font-bold tracking-tighter text-sky-600 hover:opacity-80 transition-opacity">
          ACTIVE<span class="text-slate-800">14</span>
        </a>

        <nav class="hidden md:flex gap-2">
          {navItems.map((item) => {
            const active = isActive(item.href);
            return (
              <a
                href={item.href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "px-4 py-2 rounded-full text-sm font-bold transition-all duration-200",
                  active
                    ? "bg-sky-100 text-sky-700 shadow-sm translate-y-[-1px] pointer-events-none cursor-default" 
                    : "text-slate-500 hover:text-sky-600 hover:bg-sky-50"
                ]}
              >
                {item.label}
              </a>
            );
          })}
        </nav>

        <button id="mobile-menu-btn" class="md:hidden text-slate-600 p-2 hover:bg-slate-100 rounded-full transition-colors" aria-label="メニューを開く">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
      </div>

      <div id="mobile-menu" class="hidden absolute top-20 left-0 w-full bg-white border-b border-sky-100 shadow-lg p-4 flex-col gap-2 md:hidden">
        {navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                "block w-full px-4 py-3 rounded-xl text-center font-bold transition-all",
                active
                  ? "bg-sky-100 text-sky-700 pointer-events-none"
                  : "text-slate-600 hover:bg-sky-50 hover:text-sky-600"
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </div>
    </header>

    <main class="w-full pt-10 pb-20 flex-1" transition:name="main-content">
      <slot />
    </main>

    <footer class="w-full bg-sky-900 py-10 mt-auto border-t border-sky-800">
      <div class="max-w-5xl mx-auto px-6 text-center">
        <p class="text-white font-bold text-xl mb-2">ACTIVE14</p>
        <p class="text-sky-200 text-sm">© 2026 ACTIVE14. All Rights Reserved.</p>
      </div>
    </footer>

    <script>
      document.addEventListener('astro:page-load', () => {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        
        if (btn && menu) {
          // メニュー項目をクリックした時も閉じるようにする
          const links = menu.querySelectorAll('a');
          links.forEach(link => {
            link.addEventListener('click', () => {
              menu.classList.add('hidden');
              menu.classList.remove('flex');
            });
          });

          // ボタンクリックでの開閉
          btn.addEventListener('click', () => {
            menu.classList.toggle('hidden');
            menu.classList.toggle('flex');
          });
        }
      });
    </script>
    
    <script type="module" src="/assets/site.js"></script>
    <Analytics />
  </body>
</html>