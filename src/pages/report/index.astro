---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const reports = await getCollection("reports");
const sortedReports = reports.sort((a, b) => {
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});
---

<BaseLayout title="REPORT - ACTIVE14">
  <div class="main-container max-w-5xl mx-auto px-6 w-full">
    <section class="ui-card">
      <h1 class="text-3xl font-bold text-sky-600 mb-2">活動記録</h1>
      <p class="text-lg text-slate-600">これまでの活動の様子をお届けします。</p>
    </section>

    {sortedReports.map((post) => (
      <section class="ui-card flex flex-col md:flex-row gap-6 items-center md:items-start">
        <div class="flex-1 w-full">
          <p class="text-sm font-bold text-sky-500 mb-1">{post.data.date}</p>
          <h2 class="text-2xl font-bold text-slate-800 mb-3">{post.data.title}</h2>
          <p class="text-slate-600 mb-2 line-clamp-2">{post.data.summary}</p>
          <p class="text-sm text-slate-500 mb-4">参加人数: {post.data.participants} ・ 回収量: {post.data.collected}</p>
          <a href={`/r/${post.data.id}/`} class="text-sky-600 font-bold hover:underline">
            続きを読む →
          </a>
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
