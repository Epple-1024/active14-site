---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="活動記録 | ACTIVE14">
  <div class="max-w-5xl mx-auto px-6">
    <section class="bg-white rounded-3xl shadow-lg p-8 mb-10 animate-slide-up ui-card">
      <h2 class="text-3xl font-semibold text-sky-600 mb-4">活動記録一覧</h2>
      <p class="text-lg mb-6">月ごとの活動内容を掲載します。</p>
      <div class="space-y-4">
        <a class="block bg-sky-50 border border-sky-100 rounded-2xl p-6 hover:border-sky-200 ui-card ui-card--link" href="/report/2026-01/">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-sm text-gray-500">2026年1月</p>
              <p class="text-xl font-semibold text-sky-700">2026年1月 活動記録</p>
              <p class="text-sm text-gray-500 mt-2">参加人数: 24名 ・ 回収量: 6袋</p>
            </div>
            <span class="text-sky-600 font-semibold">読む →</span>
          </div>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
