---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEntryBySlug, getCollection } from "astro:content";

export async function getStaticPaths() {
  const reports = await getCollection("reports");
  return reports.map((report) => ({
    params: { id: report.slug }
  }));
}

const { id } = Astro.params;
const entry = await getEntryBySlug("reports", id ?? "");

if (!entry) {
  return Astro.redirect("/report/");
}

const { Content } = await entry.render();
---

<BaseLayout title={`${entry.data.title} | ACTIVE14`}>
  <div class="max-w-3xl mx-auto px-6">
    <article class="bg-white rounded-3xl shadow-lg p-8 animate-slide-up ui-card">
      <p class="text-sm text-gray-500 mb-2">{entry.data.date}</p>
      <h2 class="text-3xl font-semibold text-sky-600 mb-6">{entry.data.title}</h2>

      <section class="space-y-4 text-lg">
        <h3 class="text-2xl font-semibold text-sky-600">活動概要</h3>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-base bg-sky-50 border border-sky-100 rounded-2xl p-5">
          <div>
            <dt class="text-sm text-gray-500">活動日</dt>
            <dd class="font-semibold text-sky-700">{entry.data.date}</dd>
          </div>
          <div>
            <dt class="text-sm text-gray-500">参加人数</dt>
            <dd class="font-semibold text-sky-700">{entry.data.participants}</dd>
          </div>
          <div>
            <dt class="text-sm text-gray-500">回収量</dt>
            <dd class="font-semibold text-sky-700">{entry.data.collected}</dd>
          </div>
        </dl>
      </section>

      <section class="mt-8 space-y-4 text-lg">
        <h3 class="text-2xl font-semibold text-sky-600">活動内容</h3>
        <Content />
      </section>

      <section class="mt-8 text-lg">
        <h3 class="text-2xl font-semibold text-sky-600 mb-2">次回案内</h3>
        <p>次回: <span data-next-date class="font-semibold"></span> 10:30〜</p>
      </section>

      <div class="mt-10">
        <a class="text-sky-600 font-semibold" href="/report/">← 活動記録一覧へ戻る</a>
      </div>
    </article>
  </div>
</BaseLayout>
