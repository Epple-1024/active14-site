---
import BaseLayout from "../layouts/BaseLayout.astro";
import OceanWindow from "../components/OceanWindow.astro";
---
<BaseLayout title="ACTIVE14 – 海の未来を、僕らの手で。">
  
  <div class="main-container max-w-5xl mx-auto px-6 w-full">
    
    <section class="ui-card">
      <h2 class="text-3xl font-semibold text-sky-600 mb-4">MISSION</h2>
      <p class="text-lg mb-4">
        私たちACTIVE14は、仙台・荒浜で月1回の海岸清掃を主に行う学生ボランティアグループです。
      </p>
      <p class="text-lg mb-4">
        できることを、できる分だけ。海が好きな人が集まって活動を続けています。
      </p>
      <a class="inline-flex items-center text-sky-600 font-semibold hover:text-sky-800 transition-colors" href="/about/">
        団体について詳しく見る →
      </a>
    </section>

    <section class="ui-card">
      <h2 class="text-3xl font-semibold text-sky-600 mb-4">次回活動日のお知らせ</h2>
      <p class="text-lg mb-2">次回は <span data-next-date class="font-bold"></span> 10:30～ 現地で活動予定です。</p>
      <p class="text-lg mb-2">毎月第2日曜日 10:30〜（荒天時は中止）</p>
      <p class="text-sm text-gray-600">※中止の場合はこのサイトでお知らせします。</p>
    </section>

    <div class="pinned-sequence-wrapper">
      <div class="pinned-sequence-container">
        
        <section class="ui-card">
          <h2 class="text-3xl font-semibold text-sky-600 mb-4">参加について</h2>
          <p class="text-lg mb-3">初めてでも大丈夫。1人参加も歓迎です。</p>
          <div class="flex flex-col sm:flex-row gap-4 mt-4">
            <a class="flex-1" href="/join/">
              <button class="ui-button w-full bg-sky-600 hover:bg-sky-700 text-white text-lg px-6 py-3 rounded-full shadow-md">
                参加の詳細を見る
              </button>
            </a>
            <a class="flex-1" href="/contact/">
              <button class="ui-button w-full bg-white border-2 border-sky-600 text-sky-600 hover:bg-sky-50 text-lg px-6 py-3 rounded-full shadow-md">
                メールで連絡する
              </button>
            </a>
          </div>
        </section>

        <OceanWindow frameCount={90} />

        <section class="ui-card">
          <h2 class="text-3xl font-semibold text-sky-600 mb-4">活動記録</h2>
          <p class="text-lg mb-4">ここでは過去の活動報告を掲載します。月ごとに写真や参加者数などを更新していきます。</p>
          <a class="inline-flex items-center text-sky-600 font-semibold hover:text-sky-800 transition-colors" href="/report/">
            活動記録一覧へ →
          </a>
        </section>

      </div>
    </div>
  </div> 
  </BaseLayout>